@model IEnumerable<Restaurante.Models.Menu>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a class="btn btn-dark" asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Precio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Disponible)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Detalleordenes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(model => item.Precio)
            </td>
            <td>
                @Html.DisplayFor(model => item.Disponible)
            </td>
            <td>
                @Html.DisplayFor(model => item.Detalleordenes)
            </td>
            <td>
                <a class="btn btn-dark" asp-action="Edit" asp-route-id="@item.MenuId">Editar</a> |
                <a class="btn btn-warning" asp-action="Details" asp-route-id="@item.MenuId">Detalles</a> |
                <a class="btn btn-dark" asp-action="Delete" asp-route-id="@item.MenuId">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
